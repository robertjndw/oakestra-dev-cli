# Oakestra macOS testing environment
# Copy this to .env (gitignored) and adjust if needed.

# Path to your local oakestra checkout (relative paths resolve from this repo)
OAKESTRA_REPO=../oakestra

# Path to your local oakestra-net checkout, only needed to run
# root_service_manager/cluster_service_manager/netmanager from source
OAKESTRA_NET_REPO=../oakestra-net

# Used by cluster_manager to reach system_manager.
# 'system_manager' resolves via the shared Docker network - no IP needed.
SYSTEM_MANAGER_URL=system_manager

CLUSTER_NAME=test-cluster

# lat,lon,altitude - set to wherever you are if it matters for testing
CLUSTER_LOCATION=52.5200,13.4050,100

# Python library branch used when building system_manager / cluster_manager
# images. Set this to your feature branch if it changes the shared libraries.
LIB_BRANCH=develop

# NetManager release downloaded into the dockerized worker.
# Defaults to 'alpha-' + the contents of $(OAKESTRA_REPO)/version.txt
# (develop tracks the next release, which only exists as an alpha tag).
# NETMANAGER_VERSION=alpha-v0.4.411

# ── E2E suite settings (internal/oakapi) - defaults shown, override as needed ──
# OAK_ROOT_API=http://localhost:10000
# OAK_CLUSTER_API=http://localhost:10100
# OAK_ROOT_RA=http://localhost:11011
# OAK_USERNAME=Admin
# OAK_PASSWORD=Admin
# OAK_READY_TIMEOUT=180
# OAK_DEPLOY_TIMEOUT=300
